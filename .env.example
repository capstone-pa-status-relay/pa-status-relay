# Copy this file to .env.local when the app is scaffolded.
# Do not commit real values.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-only (Vercel serverless functions / supabaseRepository.ts).
# No VITE_ prefix — must never be bundled into the browser build.
# Service role key bypasses RLS: there is no user auth/session flow yet
# (see DECISIONS.md), so API routes act as the single shared demo coordinator.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
